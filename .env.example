DB_URL=jdbc:postgresql://localhost:55432/diagram_studio
DB_USER=diagram
DB_PASSWORD=diagram_local_only

# Set in the server environment; .env is not automatically loaded.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PROVIDER=smtp
# For free Render hosting, use gmail-api and set these in Render's secret store.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true
COOKIE_SECURE=false
SERVER_PORT=8090
MANAGEMENT_PORT=8091
MANAGEMENT_ADDRESS=127.0.0.1
AUTH_MAX_ATTEMPTS=30
AUTH_RATE_WINDOW=PT15M
STUDIO_OPS_USERNAME=metrics
STUDIO_OPS_PASSWORD=

# Full accounts locally; set false only for the email-free hosted guest demo.
ACCOUNTS_ENABLED=true
